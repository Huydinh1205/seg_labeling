  "cards": [
    {
      "dot": "emerald",
      "title": "Chuẩn bị một lần cho mỗi site",
      "items": [
        "tiling.py: ortho .tif → data/tiles/images/",
        "features.py: tile → data/features/*.npy",
        "--build-feature-cache: *.npy → _patch_feats.npy",
        "--build-sam-cache: ortho + cache → sam_masks",
        "init_labels_gpkg.py: → 1 layer mỗi loài"
      ]
    },
    {
      "dot": "cyan",
      "title": "Vòng lặp gán nhãn, cho từng loài",
      "items": [
        "Click layer loài, Geo-SAM bám theo layer đó",
        "FG → click → S: ảnh canvas → 1 polygon seed",
        "Nút Propagate: seed + 2 cache → polygon auto",
        "Dọn polygon sai rồi chạy lại: 24 → 12 → 4"
      ]
    },
    {
      "dot": "violet",
      "title": "Xuất nhãn và huấn luyện",
      "items": [
        "--rasterize: mọi polygon → <site>_labels.tif",
        "tiling.py --mask: raster → data/tiles/masks/",
        "train.py: ảnh tile + mask tile → best.pt",
        "infer.py: ortho mới + best.pt → GeoTIFF",
        "Không colour augmentation (Sphagnum theo màu)"
      ]
    }
  ]
