{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Bunjilview · Alpine bog vegetation data flow",
    "output": "/home/claude/bunjilview-system.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "prep",
        "label": "Data preparation",
        "focus": [
          "ortho",
          "tiles",
          "feats",
          "fcache",
          "samcache"
        ],
        "note": "Once per site: cut tiles, extract features, build both caches."
      },
      {
        "id": "labelling",
        "label": "Labelling loop",
        "focus": [
          "qgis",
          "gpkg",
          "propagate",
          "fcache",
          "samcache"
        ],
        "note": "Draw one seed per species, propagate, clean up, repeat."
      },
      {
        "id": "training",
        "label": "Training and inference",
        "focus": [
          "gpkg",
          "autopipe",
          "labels",
          "train",
          "infer"
        ],
        "note": "Both labelling branches converge on one label raster."
      }
    ],
    "viewBox": [
      1080,
      500
    ]
  },
  "stages": [
    {
      "label": "Source data"
    },
    {
      "label": "Preprocess"
    },
    {
      "label": "Caches and candidates"
    },
    {
      "label": "Labelling"
    },
    {
      "label": "Train and predict"
    }
  ],
  "nodes": [
    {
      "id": "ortho",
      "type": "database",
      "label": "Drone orthomosaic",
      "sublabel": "ortho RGB",
      "tag": "data/raw/<site>.tif",
      "stage": 0,
      "row": 1,
      "width": 132
    },
    {
      "id": "tiles",
      "type": "backend",
      "label": "Cut tiles",
      "sublabel": "tiling.py",
      "tag": "512x512, 64 px overlap",
      "stage": 1,
      "row": 0,
      "width": 132
    },
    {
      "id": "feats",
      "type": "backend",
      "label": "DINOv2 features",
      "sublabel": "features.py",
      "tag": "768 dims per patch",
      "stage": 1,
      "row": 1,
      "width": 132
    },
    {
      "id": "autopipe",
      "type": "cloud",
      "label": "Automated branch",
      "sublabel": "k-means",
      "tag": "~40 clusters named",
      "stage": 2,
      "row": 0,
      "width": 132
    },
    {
      "id": "fcache",
      "type": "database",
      "label": "Flat feature cache",
      "sublabel": "feature cache",
      "tag": "_patch_feats.npy",
      "stage": 2,
      "row": 1,
      "width": 132
    },
    {
      "id": "samcache",
      "type": "database",
      "label": "SAM mask library",
      "sublabel": "SAM auto-mask",
      "tag": "sam_masks.gpkg",
      "stage": 2,
      "row": 2,
      "width": 132
    },
    {
      "id": "qgis",
      "type": "frontend",
      "label": "Draw seed in QGIS",
      "sublabel": "Geo-SAM",
      "tag": "1 seed per species",
      "stage": 3,
      "row": 0,
      "width": 132
    },
    {
      "id": "gpkg",
      "type": "database",
      "label": "Label GeoPackage",
      "sublabel": "one per species",
      "tag": "<site>.gpkg",
      "stage": 3,
      "row": 1,
      "width": 132
    },
    {
      "id": "propagate",
      "type": "backend",
      "label": "Propagate from seed",
      "sublabel": "propagate.py",
      "tag": "cosine + one-vs-rest",
      "stage": 3,
      "row": 2,
      "width": 132
    },
    {
      "id": "labels",
      "type": "database",
      "label": "Label raster",
      "sublabel": "class ids",
      "tag": "<site>_labels.tif",
      "stage": 4,
      "row": 0,
      "width": 132
    },
    {
      "id": "train",
      "type": "backend",
      "label": "Train",
      "sublabel": "train.py",
      "tag": "checkpoints/best.pt",
      "stage": 4,
      "row": 1,
      "width": 132
    },
    {
      "id": "infer",
      "type": "backend",
      "label": "Predict new site",
      "sublabel": "infer.py",
      "tag": "classified GeoTIFF",
      "stage": 4,
      "row": 2,
      "width": 132
    }
  ],
