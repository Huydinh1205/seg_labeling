  "cards": [
    {
      "dot": "emerald",
      "title": "One-time setup per site",
      "items": [
        "tiling.py: ortho .tif → data/tiles/images/",
        "features.py: tiles → data/features/*.npy",
        "--build-feature-cache: *.npy → _patch_feats.npy",
        "--build-sam-cache: ortho + cache → sam_masks",
        "init_labels_gpkg.py: → one layer per species"
      ]
    },
    {
      "dot": "cyan",
      "title": "Labelling loop, per species",
      "items": [
        "Click the species layer, Geo-SAM follows it",
        "FG → click → S: canvas → one seed polygon",
        "Propagate button: seed + 2 caches → auto polygons",
        "Clean up, run again: 24 → 12 → 4, no duplicates"
      ]
    },
    {
      "dot": "violet",
      "title": "Export labels and train",
      "items": [
        "--rasterize: every polygon → <site>_labels.tif",
        "tiling.py --mask: raster → data/tiles/masks/",
        "train.py: image tiles + mask tiles → best.pt",
        "infer.py: new ortho + best.pt → GeoTIFF",
        "No colour augmentation (Sphagnum differs by colour)"
      ]
    }
  ]
}